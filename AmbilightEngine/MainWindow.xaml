<Window
    x:Class="AmbilightEngine.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="using:H.NotifyIcon"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid"
          Background="{StaticResource M3WindowBackgroundBrush}">

        <Grid.Resources>
            <MenuFlyout x:Key="TrayMenuFlyout">
                <MenuFlyoutItem Text="Pokaż"
                                Command="{x:Bind ShowCommand}" />
                <MenuFlyoutItem Text="Ustawienia"
                                Command="{x:Bind OpenSettingsCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Start Ambilight"
                                Command="{x:Bind StartCommand}" />
                <MenuFlyoutItem Text="Stop Ambilight"
                                Command="{x:Bind StopCommand}" />
                <MenuFlyoutItem Text="Przełącz"
                                Command="{x:Bind ToggleCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Zamknij"
                                Command="{x:Bind ExitCommand}" />
            </MenuFlyout>

            <tb:TaskbarIcon x:Key="TrayIcon"
                            IconSource="/Assets/AppIcon.ico"
                            ToolTipText="Ambilight Engine"
                            LeftClickCommand="{x:Bind ToggleWindowVisibilityCommand}"
                            ContextFlyout="{StaticResource TrayMenuFlyout}" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="48"
              Padding="16,0,140,0"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <FontIcon Glyph="&#xE7F4;"
                          FontSize="14"
                          Opacity="0.85"
                          Foreground="{StaticResource M3OnSurfaceVariantBrush}" />
                <TextBlock Text="Ambilight Engine"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource M3OnSurfaceBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="Windows 11"
                           FontSize="12"
                           Opacity="0.55"
                           Foreground="{StaticResource M3OnSurfaceVariantBrush}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Border Grid.Column="1"
                    VerticalAlignment="Center"
                    Padding="10,4"
                    CornerRadius="10"
                    Background="{StaticResource M3SurfaceContainerHighBrush}"
                    BorderBrush="{StaticResource M3OutlineBrush}"
                    BorderThickness="1">
                <TextBlock x:Name="GlobalStatusText"
                           Text="Gotowy"
                           FontSize="12"
                           Opacity="0.8"
                           Foreground="{StaticResource M3OnSurfaceVariantBrush}" />
            </Border>
        </Grid>

        <NavigationView x:Name="NavView"
                Background="{ThemeResource M3NavigationPanelBrush}"
                Grid.Row="1"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="False"
                PaneDisplayMode="Left"
                IsPaneOpen="True"
                SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Panel główny"
                                    Tag="dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Profile"
                                    Tag="profiles">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Ustawienia"
                                    Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame"
                   Margin="0"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch" />
        </NavigationView>
    </Grid>
</Window>