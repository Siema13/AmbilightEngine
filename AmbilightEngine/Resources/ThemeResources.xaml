<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:AmbilightEngine.Helpers">

    <!-- Material-like palette, ciemny motyw pod Ambilight -->
    <Color x:Key="M3PrimaryColor">#FF6750A4</Color>
    <Color x:Key="M3OnPrimaryColor">#FFFFFFFF</Color>
    <Color x:Key="M3PrimaryContainerColor">#FFEADDFF</Color>
    <Color x:Key="M3OnPrimaryContainerColor">#FF21005D</Color>

    <Color x:Key="M3SecondaryColor">#FF625B71</Color>
    <Color x:Key="M3OnSecondaryColor">#FFFFFFFF</Color>
    <Color x:Key="M3SecondaryContainerColor">#FFE8DEF8</Color>
    <Color x:Key="M3OnSecondaryContainerColor">#FF1D192B</Color>

    <Color x:Key="M3TertiaryColor">#FF7D5260</Color>
    <Color x:Key="M3OnTertiaryColor">#FFFFFFFF</Color>
    <Color x:Key="M3TertiaryContainerColor">#FFFFD8E4</Color>
    <Color x:Key="M3OnTertiaryContainerColor">#FF31111D</Color>

    <Color x:Key="M3SurfaceColor">#FF0F0E13</Color>
    <Color x:Key="M3SurfaceContainerColor">#FF2A2733</Color>
    <Color x:Key="M3SurfaceContainerHighColor">#FF3A3644</Color>
    <Color x:Key="M3SurfaceVariantColor">#FF49454F</Color>
    <Color x:Key="M3OnSurfaceColor">#FFE6E0E9</Color>
    <Color x:Key="M3OnSurfaceVariantColor">#FFCAC4D0</Color>
    <Color x:Key="M3OutlineColor">#FF938F99</Color>
    <Color x:Key="M3ErrorColor">#FFB3261E</Color>

    <!-- Brushes - podmieniane w całości z code-behind przez SetBrush(), StaticResource tutaj jest OK -->
    <SolidColorBrush x:Key="M3PrimaryBrush" Color="{StaticResource M3PrimaryColor}" />
    <SolidColorBrush x:Key="M3OnPrimaryBrush" Color="{StaticResource M3OnPrimaryColor}" />
    <SolidColorBrush x:Key="M3PrimaryContainerBrush" Color="{StaticResource M3PrimaryContainerColor}" />
    <SolidColorBrush x:Key="M3OnPrimaryContainerBrush" Color="{StaticResource M3OnPrimaryContainerColor}" />

    <SolidColorBrush x:Key="M3SecondaryBrush" Color="{StaticResource M3SecondaryColor}" />
    <SolidColorBrush x:Key="M3OnSecondaryBrush" Color="{StaticResource M3OnSecondaryColor}" />
    <SolidColorBrush x:Key="M3SecondaryContainerBrush" Color="{StaticResource M3SecondaryContainerColor}" />
    <SolidColorBrush x:Key="M3OnSecondaryContainerBrush" Color="{StaticResource M3OnSecondaryContainerColor}" />

    <SolidColorBrush x:Key="M3TertiaryBrush" Color="{StaticResource M3TertiaryColor}" />
    <SolidColorBrush x:Key="M3OnTertiaryBrush" Color="{StaticResource M3OnTertiaryColor}" />
    <SolidColorBrush x:Key="M3TertiaryContainerBrush" Color="{StaticResource M3TertiaryContainerColor}" />
    <SolidColorBrush x:Key="M3OnTertiaryContainerBrush" Color="{StaticResource M3OnTertiaryContainerColor}" />

    <LinearGradientBrush x:Key="M3WindowBackgroundBrush"
                     StartPoint="0,0"
                     EndPoint="1,1">
        <GradientStop Color="{StaticResource M3SurfaceColor}" Offset="0.0" />
        <GradientStop Color="{StaticResource M3SurfaceContainerColor}" Offset="0.55" />
        <GradientStop Color="{StaticResource M3PrimaryContainerColor}" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="M3SurfaceBrush" Color="{StaticResource M3SurfaceColor}" />
    <SolidColorBrush x:Key="M3SurfaceContainerBrush" Color="{StaticResource M3SurfaceContainerColor}" />
    <AcrylicBrush x:Key="M3SurfaceContainerHighBrush"
      TintColor="{StaticResource M3SurfaceContainerHighColor}"
      TintOpacity="0.6"
      TintLuminosityOpacity="0.85"
      FallbackColor="{StaticResource M3SurfaceContainerHighColor}" />
    <AcrylicBrush x:Key="M3NavigationPanelBrush"
      TintColor="{StaticResource M3SurfaceContainerColor}"
      TintOpacity="0.5"
      TintLuminosityOpacity="0.8"
      FallbackColor="{StaticResource M3SurfaceContainerColor}" />
    <SolidColorBrush x:Key="M3SurfaceVariantBrush" Color="{StaticResource M3SurfaceVariantColor}" />
    <SolidColorBrush x:Key="M3OnSurfaceBrush" Color="{StaticResource M3OnSurfaceColor}" />
    <SolidColorBrush x:Key="M3OnSurfaceVariantBrush" Color="{StaticResource M3OnSurfaceVariantColor}" />
    <SolidColorBrush x:Key="M3OutlineBrush" Color="{StaticResource M3OutlineColor}" />
    <SolidColorBrush x:Key="M3ErrorBrush" Color="{StaticResource M3ErrorColor}" />

    <!-- Typografia -->
    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource M3OnSurfaceBrush}" />
    </Style>

    <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource M3OnSurfaceBrush}" />
    </Style>

    <Style x:Key="SectionSubTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource M3OnSurfaceVariantBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BodyStrongTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource M3OnSurfaceBrush}" />
    </Style>

    <!-- Cień karty -->
    <ThemeShadow x:Key="CardShadow" />

    <!-- Karta - kolor z motywu + realna elewacja (cień) -->
    <Style x:Key="MaterialCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource M3SurfaceContainerHighBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource M3OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="Margin" Value="0,0,0,18" />
        <Setter Property="Shadow" Value="{StaticResource CardShadow}" />
        <Setter Property="helpers:CardElevationHelper.Elevation" Value="16" />
    </Style>

    <Style x:Key="CardStyle" TargetType="Border" BasedOn="{StaticResource MaterialCardStyle}" />

    <Style x:Key="MaterialPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource M3PrimaryBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource M3OnPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialPrimaryButtonStyle}" />

    <Style x:Key="MaterialTonalButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource M3SecondaryContainerBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource M3OnSecondaryContainerBrush}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="MaterialTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{ThemeResource M3SurfaceContainerHighBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource M3OnSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource M3OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,4,0,8" />
    </Style>

    <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource MaterialTextBoxStyle}" />

    <Style x:Key="SettingsPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="Background" Value="{ThemeResource M3SurfaceContainerHighBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource M3OnSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource M3OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,4,0,8" />
    </Style>

    <Style x:Key="MaterialComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{ThemeResource M3SurfaceContainerHighBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource M3OnSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource M3OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Margin" Value="0,4,0,8" />
    </Style>

    <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource MaterialComboBoxStyle}" />

    <Style x:Key="SettingsCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{ThemeResource M3OnSurfaceBrush}" />
        <Setter Property="Margin" Value="0,4,0,4" />
    </Style>

    <Style x:Key="ThemePresetButtonStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="MinWidth" Value="110" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Background" Value="{ThemeResource M3SurfaceContainerHighBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource M3OnSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource M3OutlineBrush}" />
    </Style>

</ResourceDictionary>