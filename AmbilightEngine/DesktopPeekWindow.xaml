<Window
    x:Class="AmbilightEngine.DesktopPeekWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="#EE202020" CornerRadius="10" Padding="12">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Oceniasz pulpit. Wróć, gdy skończysz:"
                       Foreground="White" VerticalAlignment="Center" FontSize="13" />
            <Button x:Name="ReturnButton" Content="Powrót do kalibratora (F9)" Click="ReturnButton_Click" />
        </StackPanel>
    </Border>
</Window>