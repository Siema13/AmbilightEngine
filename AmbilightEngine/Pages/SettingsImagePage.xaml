<Page
    x:Class="AmbilightEngine.Pages.SettingsImagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollMode="Auto"
                  VerticalScrollBarVisibility="Auto">
        <Grid Padding="32"
              MaxWidth="900"
              HorizontalAlignment="Left"
              Background="{ThemeResource M3SurfaceContainerBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Nagłówek -->
            <StackPanel Grid.Row="0"
                        Spacing="4">
                <TextBlock Text="Obraz i kalibracja"
                           Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Parametry obrazu stosowane do domyślnego profilu."
                           Style="{StaticResource SectionSubTextStyle}" />
            </StackPanel>

            <!-- Liczba LED / próbkowanie -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Parametry przechwytywania"
                               Style="{StaticResource SectionHeaderTextStyle}" />
                    <TextBlock Text="Liczba diod LED i głębokość próbkowania krawędzi."
                               Style="{StaticResource SectionSubTextStyle}" />

                    <TextBlock Text="Liczba diod LED"
                               FontWeight="SemiBold" />
                    <controls:NumberBox x:Name="LedCountBox"
                                        Minimum="1"
                                        Maximum="1000"
                                        SpinButtonPlacementMode="Inline"
                                        ValueChanged="LedCountBox_ValueChanged" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Głębokość próbkowania krawędzi (px)"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="SamplingDepthValueText"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="80" />
                    </Grid>

                    <Slider x:Name="SamplingDepthSlider"
                            Minimum="20"
                            Maximum="300"
                            StepFrequency="1"
                            ValueChanged="SamplingDepthSlider_ValueChanged" />

                    <Grid ColumnSpacing="12" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Miękka krawędź obrazu (px)"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="EdgeFeatherValueText"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="2" />
                    </Grid>

                    <Slider x:Name="EdgeFeatherSlider"
                            Minimum="0"
                            Maximum="40"
                            StepFrequency="1"
                            ValueChanged="EdgeFeatherSlider_ValueChanged" />
                    <TextBlock Text="Osłabia wpływ pierwszych N pikseli od krawędzi obrazu na kolor diod (zamiast całkowicie je odcinać) - eliminuje obrys przechwytywania Windows lub overscan, zachowując płynne przejście."
                               Style="{StaticResource SectionSubTextStyle}" />
                </StackPanel>
            </Border>

            <!-- Treść -->
            <StackPanel Grid.Row="1"
                        Margin="0,24,0,0"
                        Spacing="16">

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Kalibracja obrazu"
                                   Style="{StaticResource SectionHeaderTextStyle}" />

                        <!-- Jasność -->
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Jasność (%)"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="BrightnessValueText"
                                           Grid.Column="1"
                                           Text="100" />
                            </Grid>
                            <Slider x:Name="BrightnessSlider"
                                    Minimum="0"
                                    Maximum="100"
                                    StepFrequency="1"
                                    ValueChanged="BrightnessSlider_ValueChanged" />
                        </StackPanel>

                        <!-- Nasycenie -->
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Nasycenie (%)"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="SaturationValueText"
                                           Grid.Column="1"
                                           Text="100" />
                            </Grid>
                            <Slider x:Name="SaturationSlider"
                                    Minimum="0"
                                    Maximum="300"
                                    StepFrequency="1"
                                    ValueChanged="SaturationSlider_ValueChanged" />
                            <TextBlock Text="100 = neutralne, mniej = bledsze kolory, więcej = bardziej intensywne."
                                       Style="{StaticResource SectionSubTextStyle}" />
                        </StackPanel>

                        <!-- Temperatura barwowa -->
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Temperatura barwowa (K)"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="KelvinValueText"
                                           Grid.Column="1"
                                           Text="6500" />
                            </Grid>
                            <Slider x:Name="KelvinSlider"
                                    Minimum="1000"
                                    Maximum="12000"
                                    StepFrequency="100"
                                    ValueChanged="KelvinSlider_ValueChanged" />
                        </StackPanel>

                        <!-- Próg czerni -->
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Próg czerni"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="BlackCutoffValueText"
                                           Grid.Column="1"
                                           Text="8" />
                            </Grid>
                            <Slider x:Name="BlackCutoffSlider"
                                    Minimum="0"
                                    Maximum="50"
                                    StepFrequency="1"
                                    ValueChanged="BlackCutoffSlider_ValueChanged" />
                            <TextBlock Text="Piksele ciemniejsze niż ten próg będą wygaszane do czystej czerni."
                                       Style="{StaticResource SectionSubTextStyle}" />
                        </StackPanel>

                        <!-- Gamma -->
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Korekcja gamma"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="GammaValueText"
                                           Grid.Column="1"
                                           Text="2.2" />
                            </Grid>
                            <Slider x:Name="GammaSlider"
                                    Minimum="10"
                                    Maximum="40"
                                    StepFrequency="1"
                                    ValueChanged="GammaSlider_ValueChanged" />
                            <TextBlock Text="Standardowo 2.2. Zwiększ, jeśli diody świecą za jasno; zmniejsz, jeśli za ciemno."
                                       Style="{StaticResource SectionSubTextStyle}" />
                        </StackPanel>

                        <!-- Reakcja przechwytywania -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="Reakcja przechwytywania"
                                       Style="{StaticResource SectionHeaderTextStyle}" />
                            <TextBlock Text="Steruje szybkością reakcji diod na zmiany obrazu oraz czułością na drobne ruchy."
                                       Style="{StaticResource SectionSubTextStyle}" />

                            <!-- Szybkość ataku (narastania) -->
                            <StackPanel Spacing="6">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Szybkość reakcji (atak)"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="AttackSpeedValueText"
                                               Grid.Column="1"
                                               Text="1.0" />
                                </Grid>
                                <Slider x:Name="AttackSpeedSlider"
                                        Minimum="0.1"
                                        Maximum="5.0"
                                        StepFrequency="0.1"
                                        ValueChanged="AttackSpeedSlider_ValueChanged" />
                                <TextBlock Text="Wyższa wartość = agresywniejsza reakcja na nagłe zmiany (tryb gra)."
                                           Style="{StaticResource SectionSubTextStyle}" />
                            </StackPanel>

                            <!-- Szybkość zanikania (decay) -->
                            <StackPanel Spacing="6">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Szybkość wygaszania (zanik)"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="DecaySpeedValueText"
                                               Grid.Column="1"
                                               Text="1.0" />
                                </Grid>
                                <Slider x:Name="DecaySpeedSlider"
                                        Minimum="0.1"
                                        Maximum="5.0"
                                        StepFrequency="0.1"
                                        ValueChanged="DecaySpeedSlider_ValueChanged" />
                                <TextBlock Text="Niższa wartość = dłuższe utrzymanie koloru (bardziej filmowo)."
                                           Style="{StaticResource SectionSubTextStyle}" />
                            </StackPanel>

                            <!-- Czułość na zmiany -->
                            <StackPanel Spacing="6">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Czułość na zmiany koloru"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="ColorSensitivityValueText"
                                               Grid.Column="1"
                                               Text="1.0" />
                                </Grid>
                                <Slider x:Name="ColorSensitivitySlider"
                                        Minimum="0.1"
                                        Maximum="6.0"
                                        StepFrequency="0.1"
                                        ValueChanged="ColorSensitivitySlider_ValueChanged" />
                                <TextBlock Text="Wyższa wartość = reaguje nawet na drobne zmiany; niższa = filtruje szum. Zakres rozszerzony do 6.0."
                                           Style="{StaticResource SectionSubTextStyle}" />
                            </StackPanel>

                            <!-- Minimalna jasność (bias lighting) -->
                            <StackPanel Spacing="6">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Minimalna jasność tła"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="MinBrightnessValueText"
                                               Grid.Column="1"
                                               Text="5" />
                                </Grid>
                                <Slider x:Name="MinBrightnessSlider"
                                        Minimum="0"
                                        Maximum="64"
                                        StepFrequency="1"
                                        ValueChanged="MinBrightnessSlider_ValueChanged" />
                                <TextBlock Text="0 = pełna czerń przy ciemnym obrazie, wyższe wartości = delikatna poświata tła."
                                           Style="{StaticResource SectionSubTextStyle}" />
                            </StackPanel>

                            <!-- Wykrywanie szybkich/małych obiektów (peak-blend) -->
                            <StackPanel Spacing="6">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Wykrywanie szybkich/małych obiektów (%)"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="ZonePeakWeightValueText"
                                               Grid.Column="1"
                                               Text="30" />
                                </Grid>
                                <Slider x:Name="ZonePeakWeightSlider"
                                        Minimum="0"
                                        Maximum="100"
                                        StepFrequency="5"
                                        ValueChanged="ZonePeakWeightSlider_ValueChanged" />
                                <TextBlock Text="0 = czysta średnia strefy (jak dotychczas), więcej = mocniej reaguje na pojedynczy jasny obiekt, nawet jeśli zajmuje małą część strefy."
                                           Style="{StaticResource SectionSubTextStyle}" />
                            </StackPanel>

                            <!-- Wzmocnienie cieni -->
                            <StackPanel Spacing="6">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Wzmocnienie cieni"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="ShadowBoostValueText"
                                               Grid.Column="1"
                                               Text="1.0" />
                                </Grid>
                                <Slider x:Name="ShadowBoostSlider"
                                        Minimum="10"
                                        Maximum="40"
                                        StepFrequency="1"
                                        ValueChanged="ShadowBoostSlider_ValueChanged" />
                                <TextBlock Text="1.0 = wyłączone. Wyższe wartości silniej podnoszą słabe/ciemne kolory, bez rozjaśniania już jasnych scen."
                                           Style="{StaticResource SectionSubTextStyle}" />
                            </StackPanel>

                            <!-- Próg szumu -->
                            <StackPanel Spacing="6">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Próg szumu"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="NoiseFloorValueText"
                                               Grid.Column="1"
                                               Text="4" />
                                </Grid>
                                <Slider x:Name="NoiseFloorSlider"
                                        Minimum="0"
                                        Maximum="32"
                                        StepFrequency="1"
                                        ValueChanged="NoiseFloorSlider_ValueChanged" />
                                <TextBlock Text="Chroni przed migotaniem na czarnym tle przy wysokiej czułości/wzmocnieniu cieni. Zwiększ, jeśli widzisz szum na ciemnych scenach."
                                           Style="{StaticResource SectionSubTextStyle}" />
                            </StackPanel>

                            <!-- Wygładzanie fazowe -->
                            <StackPanel Spacing="6">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Wygładzanie fazowe (%)"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="PhaseSmoothingValueText"
                                               Grid.Column="1"
                                               Text="0" />
                                </Grid>
                                <Slider x:Name="PhaseSmoothingSlider"
                                        Minimum="0"
                                        Maximum="100"
                                        StepFrequency="5"
                                        ValueChanged="PhaseSmoothingSlider_ValueChanged" />
                                <TextBlock Text="0 = wyłączone. Redukuje subtelną chropowatość koloru przy bardzo powolnym ruchu treści o kilka pikseli, kosztem niewielkiego dodatkowego opóźnienia."
                                           Style="{StaticResource SectionSubTextStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Kalibracja koloru per kanał RGB -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Kalibracja koloru per kanał"
                                           Style="{StaticResource SectionHeaderTextStyle}" />
                                <TextBlock Text="Koryguje rozjazd koloru między obrazem na ekranie a rzeczywistym wyświetlaniem LED (np. różnice w widmie diod)."
                                           Style="{StaticResource SectionSubTextStyle}" />

                                <StackPanel Spacing="6">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Kanał R (%)"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="ChannelGainRValueText"
                                                   Grid.Column="1"
                                                   Text="100" />
                                    </Grid>
                                    <Slider x:Name="ChannelGainRSlider"
                                            Minimum="20"
                                            Maximum="200"
                                            StepFrequency="1"
                                            ValueChanged="ChannelGainRSlider_ValueChanged" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Kanał G (%)"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="ChannelGainGValueText"
                                                   Grid.Column="1"
                                                   Text="100" />
                                    </Grid>
                                    <Slider x:Name="ChannelGainGSlider"
                                            Minimum="20"
                                            Maximum="200"
                                            StepFrequency="1"
                                            ValueChanged="ChannelGainGSlider_ValueChanged" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Kanał B (%)"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="ChannelGainBValueText"
                                                   Grid.Column="1"
                                                   Text="100" />
                                    </Grid>
                                    <Slider x:Name="ChannelGainBSlider"
                                            Minimum="20"
                                            Maximum="200"
                                            StepFrequency="1"
                                            ValueChanged="ChannelGainBSlider_ValueChanged" />
                                    <TextBlock Text="100% = neutralne. Zwiększ kanał, jeśli LED wyświetla go za słabo względem ekranu; zmniejsz, jeśli za intensywnie."
                                               Style="{StaticResource SectionSubTextStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Kalibracja barwy ściany -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Kalibracja barwy ściany"
                                           Style="{StaticResource SectionHeaderTextStyle}" />
                                <TextBlock Text="Kompensuje wpływ koloru ściany na odcień diod. Wskaż dominującą barwę ściany za telewizorem."
                                           Style="{StaticResource SectionSubTextStyle}" />

                                <ToggleSwitch x:Name="WallColorToggle"
                                              Header="Włącz kompensację barwy ściany"
                                              IsOn="False"
                                              Toggled="WallColorToggle_Toggled" />

                                <StackPanel x:Name="WallColorPanel" Spacing="12">

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Kolor ściany"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />

                                        <Border x:Name="WallColorPreview"
                                                Grid.Column="1"
                                                Width="40"
                                                Height="28"
                                                CornerRadius="6"
                                                BorderThickness="1"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                Background="#808080" />

                                        <Button x:Name="WallColorPickerButton"
                                                Grid.Column="2"
                                                Content="Wybierz..."
                                                Click="WallColorPickerButton_Click" />
                                    </Grid>

                                    <TextBlock x:Name="WallColorHexText"
                                               Text="#808080"
                                               Style="{StaticResource SectionSubTextStyle}" />

                                    <StackPanel Spacing="6">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Siła kompensacji (%)"
                                                       FontWeight="SemiBold" />
                                            <TextBlock x:Name="WallStrengthValueText"
                                                       Grid.Column="1"
                                                       Text="50" />
                                        </Grid>
                                        <Slider x:Name="WallStrengthSlider"
                                                Minimum="0"
                                                Maximum="100"
                                                StepFrequency="1"
                                                Value="50"
                                                ValueChanged="WallStrengthSlider_ValueChanged" />
                                        <TextBlock Text="0 = wyłączona, 100 = pełna kompensacja. Zacznij od 30–50%."
                                                   Style="{StaticResource SectionSubTextStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Wykrywanie czarnych pasów -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Wykrywanie czarnych pasów"
                                   Style="{StaticResource SectionHeaderTextStyle}" />
                                <TextBlock Text="Automatycznie wykrywa czarne pasy (letterbox) przy filmach w formacie kinowym i przesuwa strefy diod na faktyczny obraz."
                                   Style="{StaticResource SectionSubTextStyle}" />

                                <ToggleSwitch x:Name="BlackBarToggle"
                                      Header="Włącz wykrywanie czarnych pasów"
                                      IsOn="False"
                                      Toggled="BlackBarToggle_Toggled" />

                                <StackPanel x:Name="BlackBarPanel" Spacing="12">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Próg czerni pasów"
                                               FontWeight="SemiBold" />
                                            <TextBlock x:Name="BlackBarThresholdValueText"
                                               Grid.Column="1"
                                               Text="18" />
                                        </Grid>
                                        <Slider x:Name="BlackBarThresholdSlider"
                                        Minimum="0"
                                        Maximum="64"
                                        StepFrequency="1"
                                        ValueChanged="BlackBarThresholdSlider_ValueChanged" />
                                        <TextBlock Text="Piksele jaśniejsze niż ten próg nie są uznawane za czarny pas."
                                           Style="{StaticResource SectionSubTextStyle}" />
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Wymagany udział czarnych pikseli (%)"
                                               FontWeight="SemiBold" />
                                            <TextBlock x:Name="BlackBarMinRatioValueText"
                                               Grid.Column="1"
                                               Text="92" />
                                        </Grid>
                                        <Slider x:Name="BlackBarMinRatioSlider"
                                        Minimum="50"
                                        Maximum="100"
                                        StepFrequency="1"
                                        ValueChanged="BlackBarMinRatioSlider_ValueChanged" />
                                        <TextBlock Text="Im wyższa wartość, tym pewniej algorytm musi być, że linia jest pasem, zanim ją odetnie."
                                           Style="{StaticResource SectionSubTextStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal"
                            Spacing="12"
                            Margin="0,16,0,0">
                    <Button x:Name="SaveAsProfileButton"
                            Content="Zapisz jako profil"
                            Click="SaveAsProfileButton_Click"
                            HorizontalAlignment="Left"
                            CornerRadius="6" />

                    <Border Margin="0,24,0,0"
        Padding="16"
        CornerRadius="12"
        Background="{ThemeResource M3SurfaceContainerHighBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Profil domyślny"
                   FontSize="16"
                   FontWeight="SemiBold" />

                            <TextBlock Text="Zapisz bieżące ustawienia obrazu jako profil używany po zamknięciu aplikacji z własnym profilem lub gdy nie ma pasującego profilu."
                   Style="{StaticResource SectionSubTextStyle}"
                   TextWrapping="Wrap" />

                            <Button Content="Zapisz bieżące ustawienia jako domyślne"
                HorizontalAlignment="Left"
                Style="{StaticResource AccentButtonStyle}"
                Click="SaveCurrentImageSettingsAsDefaultButton_Click" />

                            <TextBlock x:Name="DefaultProfileSaveStatusText"
                   Style="{StaticResource SectionSubTextStyle}"
                   TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="ResetImageDefaultsButton"
                            Content="Przywróć domyślne"
                            Click="ResetImageDefaultsButton_Click"
                            HorizontalAlignment="Left"
                            CornerRadius="6" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>

</Page>