<Page
    x:Class="AmbilightEngine.Pages.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:converters="using:AmbilightEngine.Converters">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollMode="Auto"
                  VerticalScrollBarVisibility="Auto">

        <Grid Padding="32"
              HorizontalAlignment="Stretch"
              Background="{ThemeResource M3SurfaceContainerBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Spacing="4"
                        MaxWidth="860"
                        HorizontalAlignment="Left">
                <TextBlock Text="Profile aplikacji"
                           FontSize="24"
                           FontWeight="Bold" />
                <TextBlock Text="Twórz osobne profile i przypisuj je do konkretnych aplikacji. Możesz zmieniać parametry Video Sync, ustawić stały kolor albo wybrany efekt WLED."
                           Style="{StaticResource SectionSubTextStyle}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <controls:InfoBar x:Name="ProfilesInfoBar"
                              Grid.Row="1"
                              Margin="0,20,0,0"
                              MaxWidth="860"
                              HorizontalAlignment="Left"
                              IsOpen="False"
                              IsClosable="False"
                              Severity="Informational"
                              Title="Status"
                              Message="" />

            <Border Grid.Row="2"
                    Margin="0,20,0,0"
                    MaxWidth="860"
                    HorizontalAlignment="Left"
                    Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Zarządzanie profilami"
                               Style="{StaticResource SectionHeaderTextStyle}" />

                    <TextBlock Text="Dodawaj profile, przypisuj pliki .exe i zapisuj zmiany do konfiguracji aplikacji."
                               Style="{StaticResource SectionSubTextStyle}"
                               TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="12">
                        <DropDownButton Content="Dodaj profil"
                                        Style="{StaticResource AccentButtonStyle}">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem Text="Puste (własne ustawienia)"
                                                    Tag="Custom"
                                                    Click="AddPresetProfileButton_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Gra"
                                                    Tag="Gaming"
                                                    Click="AddPresetProfileButton_Click" />
                                    <MenuFlyoutItem Text="Film"
                                                    Tag="Movie"
                                                    Click="AddPresetProfileButton_Click" />
                                    <MenuFlyoutItem Text="Lounge / Muzyka"
                                                    Tag="Lounge"
                                                    Click="AddPresetProfileButton_Click" />
                                    <MenuFlyoutItem Text="Biuro / Praca"
                                                    Tag="Office"
                                                    Click="AddPresetProfileButton_Click" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <Button Content="Zapisz zmiany"
                                Click="SaveChangesButton_Click" />
                    </StackPanel>

                    <TextBlock x:Name="SaveStatusText"
                               Text=""
                               Style="{StaticResource SectionSubTextStyle}"
                               TextWrapping="Wrap" />

                    <Border Padding="12"
                            CornerRadius="10"
                            Background="{ThemeResource M3SurfaceContainerHighBrush}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Podgląd profilu na żywo"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Włącz podgląd, a zmiana parametrów obrazu suwakiem będzie od razu widoczna na LED-ach. Zapis ustawień nadal wymaga kliknięcia „Zapisz zmiany”."
                                       Style="{StaticResource SectionSubTextStyle}"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="12">
                                <Button Content="Włącz podgląd"
                                        Click="EnableLivePreviewButton_Click"
                                        Style="{StaticResource AccentButtonStyle}" />
                                <Button Content="Zakończ podgląd"
                                        Click="DisableLivePreviewButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="3"
                    Margin="0,24,0,0"
                    MaxWidth="860"
                    HorizontalAlignment="Left"
                    Style="{StaticResource CardStyle}">
                <StackPanel Spacing="18">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Profil domyślny"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Ten profil uruchamia się automatycznie, gdy nie ma aktywnej aplikacji z przypisanym profilem — np. po zamknięciu Chrome, na pulpicie lub po przejściu do nieprzypisanej aplikacji."
                                       Style="{StaticResource SectionSubTextStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Padding="10,4"
                                CornerRadius="12"
                                VerticalAlignment="Top"
                                Background="{ThemeResource M3SurfaceContainerHighBrush}">
                            <TextBlock Text="Fallback"
                                       FontWeight="SemiBold"
                                       Opacity="0.8" />
                        </Border>
                    </Grid>

                    <Border Padding="16"
                            CornerRadius="12"
                            Background="{ThemeResource M3SurfaceContainerHighBrush}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Nazwa"
                                       FontWeight="SemiBold"
                                       FontSize="14" />
                            <TextBox Header="Nazwa profilu domyślnego"
                                     HorizontalAlignment="Stretch"
                                     Text="{Binding DefaultProfile.DisplayName, Mode=TwoWay}" />
                            <TextBlock Text="Profil domyślny nie jest powiązany z plikiem .exe i nie może zostać usunięty."
                                       Style="{StaticResource SectionSubTextStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Padding="16"
                            CornerRadius="12"
                            Background="{ThemeResource M3SurfaceContainerHighBrush}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Co ma się dziać po powrocie"
                                       FontWeight="SemiBold"
                                       FontSize="14" />
                            <TextBlock Text="Wybierz działanie wykonywane po zamknięciu aplikacji z własnym profilem albo gdy aktywne okno nie ma przypisania."
                                       Style="{StaticResource SectionSubTextStyle}"
                                       TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal"
                                        Spacing="16">
                                <RadioButton Content="Parametry obrazu"
                                             GroupName="DefaultProfileAction"
                                             IsChecked="{Binding DefaultProfile.IsActionTypeImageDsp, Mode=OneWay}"
                                             Checked="DefaultActionTypeImageDsp_Checked" />
                                <RadioButton Content="Stały kolor LED"
                                             GroupName="DefaultProfileAction"
                                             IsChecked="{Binding DefaultProfile.IsActionTypeStaticColor, Mode=OneWay}"
                                             Checked="DefaultActionTypeStaticColor_Checked" />
                                <RadioButton Content="Efekt WLED"
                                             GroupName="DefaultProfileAction"
                                             IsChecked="{Binding DefaultProfile.IsActionTypeWledEffect, Mode=OneWay}"
                                             Checked="DefaultActionTypeWledEffect_Checked" />
                            </StackPanel>

                            <StackPanel Spacing="8"
                                        Visibility="{Binding DefaultProfile.IsActionTypeStaticColor, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Kolor stały"
                                           FontWeight="SemiBold" />
                                <ColorPicker x:Name="DefaultStaticColorPicker"
                                             ColorChanged="DefaultStaticColorPicker_ColorChanged"
                                             IsAlphaEnabled="False"
                                             IsMoreButtonVisible="False" />
                            </StackPanel>

                            <StackPanel Spacing="8"
                                        Visibility="{Binding DefaultProfile.IsActionTypeWledEffect, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Numer efektu WLED (FX Id)"
                                           FontWeight="SemiBold" />
                                <NumberBox Minimum="0"
                                           Maximum="255"
                                           SpinButtonPlacementMode="Inline"
                                           Value="{Binding DefaultProfile.WledEffectId, Mode=TwoWay}" />

                                <TextBlock Text="Prędkość efektu"
                                           FontWeight="SemiBold" />
                                <Slider Minimum="0"
                                        Maximum="255"
                                        StepFrequency="1"
                                        Value="{Binding DefaultProfile.WledEffectSpeed, Mode=TwoWay}" />

                                <TextBlock Text="Intensywność efektu"
                                           FontWeight="SemiBold" />
                                <Slider Minimum="0"
                                        Maximum="255"
                                        StepFrequency="1"
                                        Value="{Binding DefaultProfile.WledEffectIntensity, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Padding="16"
                            CornerRadius="12"
                            Background="{ThemeResource M3SurfaceContainerHighBrush}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Parametry obrazu domyślnego"
                                       FontWeight="SemiBold"
                                       FontSize="14" />
                            <TextBlock Text="Te parametry są używane tylko wtedy, gdy akcją profilu domyślnego są „Parametry obrazu”, czyli gdy ma wrócić Video Sync."
                                       Style="{StaticResource SectionSubTextStyle}"
                                       TextWrapping="Wrap" />

                            <StackPanel Spacing="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Jasność (%)"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DefaultProfile.BrightnessPercent, Mode=OneWay}" />
                                </Grid>
                                <Slider Minimum="1"
                                        Maximum="100"
                                        StepFrequency="1"
                                        Value="{Binding DefaultProfile.BrightnessPercent, Mode=TwoWay}"
                                        ValueChanged="DefaultProfileImageSlider_ValueChanged" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Wygładzanie (ms)"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DefaultProfile.SmoothingSpeedMs, Mode=OneWay}" />
                                </Grid>
                                <Slider Minimum="0"
                                        Maximum="2000"
                                        StepFrequency="10"
                                        Value="{Binding DefaultProfile.SmoothingSpeedMs, Mode=TwoWay}"
                                        ValueChanged="DefaultProfileImageSlider_ValueChanged" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Próg czerni"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DefaultProfile.BlackCutoffThreshold, Mode=OneWay}" />
                                </Grid>
                                <Slider Minimum="0"
                                        Maximum="255"
                                        StepFrequency="1"
                                        Value="{Binding DefaultProfile.BlackCutoffThreshold, Mode=TwoWay}"
                                        ValueChanged="DefaultProfileImageSlider_ValueChanged" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Temperatura barwowa (K)"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DefaultProfile.ColorTemperatureKelvin, Mode=OneWay}" />
                                </Grid>
                                <Slider Minimum="1000"
                                        Maximum="12000"
                                        StepFrequency="100"
                                        Value="{Binding DefaultProfile.ColorTemperatureKelvin, Mode=TwoWay}"
                                        ValueChanged="DefaultProfileImageSlider_ValueChanged" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Gamma"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DefaultProfile.GammaValue, Mode=OneWay}" />
                                </Grid>
                                <Slider Minimum="1"
                                        Maximum="4"
                                        StepFrequency="0.1"
                                        Value="{Binding DefaultProfile.GammaValue, Mode=TwoWay}"
                                        ValueChanged="DefaultProfileImageSlider_ValueChanged" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Wzmocnienie nasycenia"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DefaultProfile.SaturationBoost, Mode=OneWay}" />
                                </Grid>
                                <Slider Minimum="0"
                                        Maximum="3"
                                        StepFrequency="0.1"
                                        Value="{Binding DefaultProfile.SaturationBoost, Mode=TwoWay}"
                                        ValueChanged="DefaultProfileImageSlider_ValueChanged" />
                            </StackPanel>

                            <Button Content="Przywróć neutralne parametry profilu domyślnego"
                                    HorizontalAlignment="Left"
                                    Click="ResetDefaultProfileImageDefaultsButton_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Grid.Row="4"
                  Margin="0,24,0,0">
                <StackPanel x:Name="ProfilesEmptyStatePanel"
                            Spacing="10"
                            MaxWidth="860"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Nie masz jeszcze żadnych profili aplikacji."
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Dodaj profil i przypisz do niego plik .exe, aby automatycznie zastosować ustawienia po wykryciu aktywnej aplikacji."
                                       Style="{StaticResource SectionSubTextStyle}"
                                       TextWrapping="Wrap" />
                            <DropDownButton Content="Dodaj pierwszy profil"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource AccentButtonStyle}">
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                        <MenuFlyoutItem Text="Puste (własne ustawienia)"
                                                        Tag="Custom"
                                                        Click="AddPresetProfileButton_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Gra"
                                                        Tag="Gaming"
                                                        Click="AddPresetProfileButton_Click" />
                                        <MenuFlyoutItem Text="Film"
                                                        Tag="Movie"
                                                        Click="AddPresetProfileButton_Click" />
                                        <MenuFlyoutItem Text="Lounge / Muzyka"
                                                        Tag="Lounge"
                                                        Click="AddPresetProfileButton_Click" />
                                        <MenuFlyoutItem Text="Biuro / Praca"
                                                        Tag="Office"
                                                        Click="AddPresetProfileButton_Click" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ItemsControl x:Name="ProfilesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,16"
                                    MaxWidth="860"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="18">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="Ustawienia tego profilu zostaną aktywowane po wykryciu wskazanego procesu."
                                                       Style="{StaticResource SectionSubTextStyle}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Usuń"
                                                Tag="{Binding}"
                                                VerticalAlignment="Top"
                                                Click="RemoveProfileButton_Click" />
                                    </Grid>

                                    <Border Padding="16"
                                            CornerRadius="12"
                                            Background="{ThemeResource M3SurfaceContainerHighBrush}">
                                        <StackPanel Spacing="14">
                                            <TextBlock Text="Powiązanie z aplikacją"
                                                       FontWeight="SemiBold"
                                                       FontSize="14" />
                                            <TextBox Header="Nazwa profilu"
                                                     Text="{Binding DisplayName, Mode=TwoWay}" />
                                            <TextBox Header="Przypisana aplikacja (.exe)"
                                                     Text="{Binding ExecutableFileName, Mode=TwoWay}" />
                                            <Button Content="Wybierz aplikację"
                                                    HorizontalAlignment="Left"
                                                    Tag="{Binding}"
                                                    Click="PickApplicationButton_Click" />
                                            <StackPanel Spacing="4">
                                                <CheckBox Content="Aktywuj także, gdy aplikacja działa w tle"
                                                          IsChecked="{Binding AllowBackgroundActivation, Mode=TwoWay}" />
                                                <TextBlock Text="Wyłącz dla zwykłych aplikacji, np. przeglądarki lub Notatnika. Włącz tylko dla aplikacji, których profil ma pozostać aktywny po utracie fokusu."
                                                           Style="{StaticResource SectionSubTextStyle}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Spacing="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Priorytet działania w tle"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Priority, Mode=OneWay}" />
                                                </Grid>
                                                <Slider Minimum="0"
                                                        Maximum="100"
                                                        StepFrequency="1"
                                                        Value="{Binding Priority, Mode=TwoWay}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="16"
                                            CornerRadius="12"
                                            Background="{ThemeResource M3SurfaceContainerHighBrush}">
                                        <StackPanel Spacing="14">
                                            <TextBlock Text="Co ma się dziać po aktywacji"
                                                       FontWeight="SemiBold"
                                                       FontSize="14" />
                                            <TextBlock Text="Domyślnie profil zmienia parametry obrazu Video Sync. Możesz też wymusić stały kolor LED albo konkretny efekt WLED."
                                                       Style="{StaticResource SectionSubTextStyle}"
                                                       TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="16">
                                                <RadioButton Content="Parametry obrazu"
                                                             GroupName="{Binding ProfileId}"
                                                             Tag="{Binding}"
                                                             IsChecked="{Binding IsActionTypeImageDsp, Mode=OneWay}"
                                                             Checked="ActionTypeImageDsp_Checked" />
                                                <RadioButton Content="Stały kolor LED"
                                                             GroupName="{Binding ProfileId}"
                                                             Tag="{Binding}"
                                                             IsChecked="{Binding IsActionTypeStaticColor, Mode=OneWay}"
                                                             Checked="ActionTypeStaticColor_Checked" />
                                                <RadioButton Content="Efekt WLED"
                                                             GroupName="{Binding ProfileId}"
                                                             Tag="{Binding}"
                                                             IsChecked="{Binding IsActionTypeWledEffect, Mode=OneWay}"
                                                             Checked="ActionTypeWledEffect_Checked" />
                                            </StackPanel>

                                            <StackPanel Spacing="8"
                                                        Visibility="{Binding IsActionTypeStaticColor, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="Kolor stały"
                                                           FontWeight="SemiBold" />
                                                <ColorPicker ColorChanged="ProfileStaticColorPicker_ColorChanged"
                                                             Tag="{Binding}"
                                                             IsAlphaEnabled="False"
                                                             IsMoreButtonVisible="False" />
                                            </StackPanel>

                                            <StackPanel Spacing="8"
                                                        Visibility="{Binding IsActionTypeWledEffect, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="Numer efektu WLED (FX Id)"
                                                           FontWeight="SemiBold" />
                                                <NumberBox Minimum="0"
                                                           Maximum="255"
                                                           SpinButtonPlacementMode="Inline"
                                                           Value="{Binding WledEffectId, Mode=TwoWay}" />
                                                <TextBlock Text="Prędkość efektu"
                                                           FontWeight="SemiBold" />
                                                <Slider Minimum="0"
                                                        Maximum="255"
                                                        StepFrequency="1"
                                                        Value="{Binding WledEffectSpeed, Mode=TwoWay}" />
                                                <TextBlock Text="Intensywność efektu"
                                                           FontWeight="SemiBold" />
                                                <Slider Minimum="0"
                                                        Maximum="255"
                                                        StepFrequency="1"
                                                        Value="{Binding WledEffectIntensity, Mode=TwoWay}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="16"
                                            CornerRadius="12"
                                            Background="{ThemeResource M3SurfaceContainerHighBrush}">
                                        <StackPanel Spacing="14">
                                            <TextBlock Text="Parametry obrazu"
                                                       FontWeight="SemiBold"
                                                       FontSize="14" />

                                            <StackPanel Spacing="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Jasność (%)"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding BrightnessPercent, Mode=OneWay}" />
                                                </Grid>
                                                <Slider Minimum="1"
                                                        Maximum="100"
                                                        StepFrequency="1"
                                                        Value="{Binding BrightnessPercent, Mode=TwoWay}"
                                                        ValueChanged="ProfileImageSlider_ValueChanged" />
                                            </StackPanel>

                                            <StackPanel Spacing="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Wygładzanie (ms)"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding SmoothingSpeedMs, Mode=OneWay}" />
                                                </Grid>
                                                <Slider Minimum="0"
                                                        Maximum="2000"
                                                        StepFrequency="10"
                                                        Value="{Binding SmoothingSpeedMs, Mode=TwoWay}"
                                                        ValueChanged="ProfileImageSlider_ValueChanged" />
                                            </StackPanel>

                                            <StackPanel Spacing="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Próg czerni"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding BlackCutoffThreshold, Mode=OneWay}" />
                                                </Grid>
                                                <Slider Minimum="0"
                                                        Maximum="255"
                                                        StepFrequency="1"
                                                        Value="{Binding BlackCutoffThreshold, Mode=TwoWay}"
                                                        ValueChanged="ProfileImageSlider_ValueChanged" />
                                            </StackPanel>

                                            <StackPanel Spacing="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Temperatura barwowa (K)"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ColorTemperatureKelvin, Mode=OneWay}" />
                                                </Grid>
                                                <Slider Minimum="1000"
                                                        Maximum="12000"
                                                        StepFrequency="100"
                                                        Value="{Binding ColorTemperatureKelvin, Mode=TwoWay}"
                                                        ValueChanged="ProfileImageSlider_ValueChanged" />
                                            </StackPanel>

                                            <StackPanel Spacing="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Gamma"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding GammaValue, Mode=OneWay}" />
                                                </Grid>
                                                <Slider Minimum="1"
                                                        Maximum="4"
                                                        StepFrequency="0.1"
                                                        Value="{Binding GammaValue, Mode=TwoWay}"
                                                        ValueChanged="ProfileImageSlider_ValueChanged" />
                                            </StackPanel>

                                            <StackPanel Spacing="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Wzmocnienie nasycenia"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding SaturationBoost, Mode=OneWay}" />
                                                </Grid>
                                                <Slider Minimum="0"
                                                        Maximum="3"
                                                        StepFrequency="0.1"
                                                        Value="{Binding SaturationBoost, Mode=TwoWay}"
                                                        ValueChanged="ProfileImageSlider_ValueChanged" />
                                            </StackPanel>

                                            <Button Content="Przywróć domyślne parametry obrazu"
                                                    HorizontalAlignment="Left"
                                                    Tag="{Binding}"
                                                    Click="ResetProfileImageDefaultsButton_Click" />
                                        </StackPanel>
