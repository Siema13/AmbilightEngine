<Page
    x:Class="AmbilightEngine.Pages.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <ScrollViewer HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollMode="Auto"
                  VerticalScrollBarVisibility="Auto">

        <Grid Padding="32" HorizontalAlignment="Stretch" Background="{ThemeResource M3SurfaceContainerBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Nagłówek -->
            <StackPanel Grid.Row="0"
                        Spacing="4"
                        MaxWidth="860"
                        HorizontalAlignment="Left">
                <TextBlock Text="Profile aplikacji"
                           FontSize="24"
                           FontWeight="Bold" />
                <TextBlock Text="Twórz osobne profile obrazu i przypisuj je do konkretnych aplikacji. Po wykryciu procesu odpowiednie ustawienia zostaną aktywowane automatycznie."
                           Style="{StaticResource SectionSubTextStyle}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Status -->
            <controls:InfoBar x:Name="ProfilesInfoBar"
                              Grid.Row="1"
                              Margin="0,20,0,0"
                              MaxWidth="860"
                              HorizontalAlignment="Left"
                              IsOpen="False"
                              IsClosable="False"
                              Severity="Informational"
                              Title="Status"
                              Message="" />

            <!-- Akcje -->
            <Border Grid.Row="2"
                    Margin="0,20,0,0"
                    MaxWidth="860"
                    HorizontalAlignment="Left"
                    Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Zarządzanie profilami"
                               Style="{StaticResource SectionHeaderTextStyle}" />

                    <TextBlock Text="Dodawaj nowe profile, przypisuj pliki .exe i zapisuj zmiany do konfiguracji aplikacji."
                               Style="{StaticResource SectionSubTextStyle}"
                               TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Dodaj profil"
                                Click="AddProfileButton_Click"
                                Style="{StaticResource AccentButtonStyle}" />

                        <Button Content="Zapisz zmiany"
                                Click="SaveChangesButton_Click" />
                    </StackPanel>

                    <TextBlock x:Name="SaveStatusText"
                               Text=""
                               Style="{StaticResource SectionSubTextStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Pusty stan + lista -->
            <Grid Grid.Row="3"
                  Margin="0,24,0,0">
                <StackPanel x:Name="ProfilesEmptyStatePanel"
                            Spacing="10"
                            MaxWidth="860"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Nie masz jeszcze żadnych profili."
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Profil pozwala przypisać osobne ustawienia obrazu do konkretnej aplikacji (.exe). To wygodny sposób na inne parametry dla gier, filmów i zwykłej pracy."
                                       Style="{StaticResource SectionSubTextStyle}"
                                       TextWrapping="Wrap" />
                            <Button Content="Dodaj pierwszy profil"
                                    Click="AddProfileButton_Click"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ItemsControl x:Name="ProfilesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,16"
                                    MaxWidth="860"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource CardStyle}">

                                <StackPanel Spacing="18">
                                    <!-- Nagłówek karty -->
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="Ustawienia tego profilu zostaną aktywowane po wykryciu wskazanego procesu."
                                                       Style="{StaticResource SectionSubTextStyle}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Content="Usuń"
                                                Tag="{Binding}"
                                                VerticalAlignment="Top"
                                                Click="RemoveProfileButton_Click" />
                                    </Grid>

                                    <!-- Dane podstawowe -->
                                    <Border Padding="16"
                                            CornerRadius="12"
                                            Background="{ThemeResource M3SurfaceContainerHighBrush}">
                                        <StackPanel Spacing="14">
                                            <TextBlock Text="Powiązanie z aplikacją"
                                                       FontWeight="SemiBold"
                                                       FontSize="14" />

                                            <TextBox Header="Nazwa profilu"
                                                     HorizontalAlignment="Stretch"
                                                     Text="{Binding DisplayName, Mode=TwoWay}" />

                                            <TextBox Header="Przypisana aplikacja (.exe)"
                                                     HorizontalAlignment="Stretch"
                                                     Text="{Binding ExecutableFileName, Mode=TwoWay}" />

                                            <Button Content="Wybierz aplikację"
                                                    HorizontalAlignment="Left"
                                                    Tag="{Binding}"
                                                    Click="PickApplicationButton_Click" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Parametry obrazu -->
                                    <Border Padding="16"
                                            CornerRadius="12"
                                            Background="{ThemeResource M3SurfaceContainerHighBrush}">
                                        <StackPanel Spacing="14">
                                            <TextBlock Text="Parametry obrazu"
                                                       FontWeight="SemiBold"
                                                       FontSize="14" />

                                            <StackPanel Spacing="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="Jasność (%)"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding BrightnessPercent, Mode=OneWay}" />
                                                </Grid>

                                                <Slider Minimum="1"
                                                        Maximum="100"
                                                        StepFrequency="1"
                                                        Value="{Binding BrightnessPercent, Mode=TwoWay}" />
                                            </StackPanel>

                                            <StackPanel Spacing="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="Wygładzanie (ms)"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding SmoothingSpeedMs, Mode=OneWay}" />
                                                </Grid>

                                                <Slider Minimum="0"
                                                        Maximum="2000"
                                                        StepFrequency="10"
                                                        Value="{Binding SmoothingSpeedMs, Mode=TwoWay}" />
                                            </StackPanel>

                                            <StackPanel Spacing="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="Próg czerni"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding BlackCutoffThreshold, Mode=OneWay}" />
                                                </Grid>

                                                <Slider Minimum="0"
                                                        Maximum="255"
                                                        StepFrequency="1"
                                                        Value="{Binding BlackCutoffThreshold, Mode=TwoWay}" />
                                            </StackPanel>

                                            <StackPanel Spacing="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="Temperatura barwowa (K)"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ColorTemperatureKelvin, Mode=OneWay}" />
                                                </Grid>

                                                <Slider Minimum="1000"
                                                        Maximum="12000"
                                                        StepFrequency="100"
                                                        Value="{Binding ColorTemperatureKelvin, Mode=TwoWay}" />
                                            </StackPanel>

                                            <StackPanel Spacing="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="Gamma"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding GammaValue, Mode=OneWay}" />
                                                </Grid>

                                                <Slider Minimum="1"
                                                        Maximum="4"
                                                        StepFrequency="0.1"
                                                        Value="{Binding GammaValue, Mode=TwoWay}" />
                                            </StackPanel>

                                            <StackPanel Spacing="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="Wzmocnienie nasycenia"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding SaturationBoost, Mode=OneWay}" />
                                                </Grid>

                                                <Slider Minimum="0"
                                                        Maximum="5"
                                                        StepFrequency="0.1"
                                                        Value="{Binding SaturationBoost, Mode=TwoWay}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>