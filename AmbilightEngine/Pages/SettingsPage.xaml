<Page
    x:Class="AmbilightEngine.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Padding="24,24,12,24"
                    Spacing="12"
                    Background="{ThemeResource M3NavigationPanelBrush}">

            <TextBlock Text="Ustawienia"
                       Style="{StaticResource PageTitleTextStyle}" />

            <TextBlock Text="Wybierz kategorię ustawień z listy poniżej."
                       Style="{StaticResource SectionSubTextStyle}" />

            <ListView x:Name="SettingsSectionList"
                      SelectionChanged="SettingsSectionList_SelectionChanged">

                <ListViewItem Content="Ogólne"
                              Tag="general" />

                <ListViewItem Content="Obraz"
                              Tag="image" />

                <ListViewItem Content="Geometria LED"
                              Tag="geometry" />

                <ListViewItem Content="WLED"
                              Tag="wled" />

                <ListViewItem Content="Uruchamianie"
                              Tag="startup" />

                <ListViewItem Content="Skróty klawiszowe"
                              Tag="hotkeys" />

                <ListViewItem Content="MQTT"
                              Tag="mqtt" />
            </ListView>
        </StackPanel>

        <Frame x:Name="SettingsContentFrame"
               Grid.Column="1"
               Margin="0"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch" />
    </Grid>
</Page>