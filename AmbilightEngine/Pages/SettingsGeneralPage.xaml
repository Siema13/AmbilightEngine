<Page
    x:Class="AmbilightEngine.Pages.SettingsGeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>

        <Style x:Key="ColorDialogStyle" TargetType="ContentDialog">
            <Setter Property="Title" Value="Wybierz kolor" />
            <Setter Property="DefaultButton" Value="Primary" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource M3SurfaceContainerBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="24,24,24,32"
                        Spacing="20"
                        MaxWidth="920"
                        HorizontalAlignment="Left">

                <StackPanel Spacing="4">
                    <TextBlock Text="Ogólne"
                               Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="Wygląd aplikacji i podstawowe ustawienia interfejsu."
                               Style="{StaticResource SectionSubTextStyle}" />
                </StackPanel>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Preset motywu"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Wybierz gotowy wariant kolorystyczny dla całej aplikacji."
                                   Style="{StaticResource SectionSubTextStyle}" />

                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Button x:Name="ThemeBlueButton"
                                    Grid.Row="0" Grid.Column="0"
                                    Content="Blue" Tag="Blue"
                                    Style="{StaticResource ThemePresetButtonStyle}"
                                    Click="ThemePresetButton_Click" />

                            <Button x:Name="ThemeIndigoButton"
                                    Grid.Row="0" Grid.Column="1"
                                    Content="Indigo" Tag="Indigo"
                                    Style="{StaticResource ThemePresetButtonStyle}"
                                    Click="ThemePresetButton_Click" />

                            <Button x:Name="ThemeTealButton"
                                    Grid.Row="0" Grid.Column="2"
                                    Content="Teal" Tag="Teal"
                                    Style="{StaticResource ThemePresetButtonStyle}"
                                    Click="ThemePresetButton_Click" />

                            <Button x:Name="ThemeGreenButton"
                                    Grid.Row="1" Grid.Column="0"
                                    Content="Green" Tag="Green"
                                    Style="{StaticResource ThemePresetButtonStyle}"
                                    Click="ThemePresetButton_Click" />

                            <Button x:Name="ThemeOrangeButton"
                                    Grid.Row="1" Grid.Column="1"
                                    Content="Orange" Tag="Orange"
                                    Style="{StaticResource ThemePresetButtonStyle}"
                                    Click="ThemePresetButton_Click" />

                            <Button x:Name="ThemePurpleButton"
                                    Grid.Row="1" Grid.Column="2"
                                    Content="Purple" Tag="Purple"
                                    Style="{StaticResource ThemePresetButtonStyle}"
                                    Click="ThemePresetButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Motyw niestandardowy"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Tryb własny włącza ręczne sterowanie warstwą wizualną aplikacji."
                                   Style="{StaticResource SectionSubTextStyle}" />

                        <ToggleSwitch x:Name="UseCustomThemeSwitch"
                                      Header="Użyj własnego motywu"
                                      Toggled="UseCustomThemeSwitch_Toggled" />

                        <StackPanel x:Name="CustomThemePanel"
                                    Spacing="16">

                            <StackPanel Spacing="6">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Siła szkła / acrylic"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />

                                    <TextBlock x:Name="GlassOpacityValueText"
                                               Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Text="70%" />
                                </Grid>

                                <Slider x:Name="GlassOpacitySlider"
                                        Minimum="0" Maximum="100"
                                        StepFrequency="1"
                                        ValueChanged="GlassOpacitySlider_ValueChanged" />
                            </StackPanel>

                            <StackPanel Spacing="10">
                                <TextBlock Text="Kolory interfejsu"
               FontWeight="SemiBold" />
                                <TextBlock Text="Wpływają na elementy widoczne na wszystkich trzech kolumnach: nawigację, karty i przyciski."
               Style="{StaticResource SectionSubTextStyle}" />

                                <StackPanel Orientation="Horizontal"
                Spacing="16">

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Akcent interfejsu"
                       Style="{StaticResource SectionSubTextStyle}" />
                                        <Border x:Name="AccentPreview"
                    Width="40" Height="40"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource M3OutlineBrush}"
                    Background="Transparent" />
                                        <Button Content="Zmień"
                    Click="AccentColorButton_Click" />
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Tło kart i paneli"
                       Style="{StaticResource SectionSubTextStyle}" />
                                        <Border x:Name="CardSurfacePreview"
                    Width="40" Height="40"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource M3OutlineBrush}"
                    Background="Transparent" />
                                        <Button Content="Zmień"
                    Click="CardSurfaceColorButton_Click" />
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Tło paneli nawigacji"
                       Style="{StaticResource SectionSubTextStyle}" />
                                        <Border x:Name="ContentBackgroundPreview"
                    Width="40" Height="40"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource M3OutlineBrush}"
                    Background="Transparent" />
                                        <Button Content="Zmień"
                    Click="ContentBackgroundColorButton_Click" />
                                    </StackPanel>

                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="10">
                                <TextBlock Text="Kolory tła aplikacji"
               FontWeight="SemiBold" />
                                <TextBlock Text="Wpływają wyłącznie na gradient widoczny za interfejsem, sterowany wybranym poniżej stylem tła."
               Style="{StaticResource SectionSubTextStyle}" />

                                <StackPanel Orientation="Horizontal"
                Spacing="16">

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Baza tła gradientu"
                       Style="{StaticResource SectionSubTextStyle}" />
                                        <Border x:Name="WindowBackgroundPreview"
                    Width="40" Height="40"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource M3OutlineBrush}"
                    Background="Transparent" />
                                        <Button Content="Zmień"
                    Click="WindowBackgroundColorButton_Click" />
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Akcent gradientu tła"
                       Style="{StaticResource SectionSubTextStyle}" />
                                        <Border x:Name="BackgroundAccentPreview"
                    Width="40" Height="40"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource M3OutlineBrush}"
                    Background="Transparent" />
                                        <Button Content="Zmień"
                    Click="BackgroundAccentColorButton_Click" />
                                    </StackPanel>

                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="10">
                                <TextBlock Text="Styl tła"
                                           FontWeight="SemiBold" />

                                <Grid ColumnSpacing="12" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Button x:Name="PureDarkStyleButton"
                                            Grid.Row="0" Grid.Column="0"
                                            Content="Pure Dark" Tag="PureDark"
                                            Click="BackgroundStyleButton_Click" />

                                    <Button x:Name="SoftGradientStyleButton"
                                            Grid.Row="0" Grid.Column="1"
                                            Content="Soft Gradient" Tag="SoftGradient"
                                            Click="BackgroundStyleButton_Click" />

                                    <Button x:Name="AmbientHaloStyleButton"
                                            Grid.Row="1" Grid.Column="0"
                                            Content="Ambient Halo" Tag="AmbientHalo"
                                            Click="BackgroundStyleButton_Click" />

                                    <Button x:Name="GraphiteStyleButton"
                                            Grid.Row="1" Grid.Column="1"
                                            Content="Graphite" Tag="Graphite"
                                            Click="BackgroundStyleButton_Click" />

                                    <Button x:Name="DeepSpaceStyleButton"
                                            Grid.Row="2" Grid.Column="0"
                                            Content="Deep Space" Tag="DeepSpace"
                                            Click="BackgroundStyleButton_Click" />

                                    <Button x:Name="WarmDuskStyleButton"
                                            Grid.Row="2" Grid.Column="1"
                                            Content="Warm Dusk" Tag="WarmDusk"
                                            Click="BackgroundStyleButton_Click" />

                                    <Button x:Name="AuroraStyleButton"
                                            Grid.Row="3" Grid.Column="0"
                                            Content="Aurora" Tag="Aurora"
                                            Click="BackgroundStyleButton_Click" />

                                    <Button x:Name="StudioStyleButton"
                                            Grid.Row="3" Grid.Column="1"
                                            Content="Studio" Tag="Studio"
                                            Click="BackgroundStyleButton_Click" />

                                    <Button x:Name="ContrastLayeredStyleButton"
                                            Grid.Row="4" Grid.Column="0"
                                            Content="Contrast Layered" Tag="ContrastLayered"
                                            Click="BackgroundStyleButton_Click" />

                                    <Button x:Name="VelvetGlowStyleButton"
                                            Grid.Row="4" Grid.Column="1"
                                            Content="Velvet Glow" Tag="VelvetGlow"
                                            Click="BackgroundStyleButton_Click" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Powiadomienia ekranowe (OSD)"
                   FontSize="20"
                   FontWeight="SemiBold" />

                        <TextBlock Text="Krótkie potwierdzenie na ekranie po użyciu skrótu globalnego: zmiana trybu, Blackout, jasność główna, preset bieli lub scena Quick Palette."
                   Style="{StaticResource SectionSubTextStyle}"
                   TextWrapping="Wrap" />

                        <ToggleSwitch x:Name="OsdEnabledSwitch"
                      Header="Pokazuj powiadomienia OSD"
                      Toggled="OsdEnabledSwitch_Toggled" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Informacje"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Ta sekcja steruje głównie wyglądem i sposobem prezentacji interfejsu."
                                   Style="{StaticResource SectionSubTextStyle}" />
                        <TextBlock Text="Wersja aplikacji"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Ambilight Engine 1.0"
                                   Style="{StaticResource SectionSubTextStyle}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <ContentDialog x:Name="ColorPickerDialog"
                       Style="{StaticResource ColorDialogStyle}"
                       PrimaryButtonText="OK"
                       CloseButtonText="Anuluj"
                       IsPrimaryButtonEnabled="True">
            <StackPanel Spacing="10">
                <TextBlock x:Name="ColorDialogDescription"
                           Style="{StaticResource SectionSubTextStyle}" />
                <ColorPicker x:Name="DialogColorPicker"
                             IsAlphaEnabled="False"
                             IsColorChannelTextInputVisible="True"
                             IsColorSliderVisible="True"
                             IsHexInputVisible="True" />
            </StackPanel>
        </ContentDialog>

    </Grid>

</Page>